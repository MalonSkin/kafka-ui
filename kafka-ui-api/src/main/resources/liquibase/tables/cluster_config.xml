<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        集群配置主表
        存储 Kafka 集群的核心配置信息，包括连接地址、Schema Registry、ksqlDB 等
        通过外键关联认证配置、SSL 配置、指标配置和审计配置
    -->
    <changeSet id="005" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="cluster_config"/></not>
        </preConditions>
        <createTable tableName="cluster_config">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="bootstrap_servers" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_registry" type="VARCHAR(512)"/>
            <column name="schema_registry_auth_id" type="BIGINT"/>
            <column name="schema_registry_ssl_id" type="BIGINT"/>
            <column name="ksqldb_server" type="VARCHAR(512)"/>
            <column name="ksqldb_server_auth_id" type="BIGINT"/>
            <column name="ksqldb_server_ssl_id" type="BIGINT"/>
            <column name="ssl_truststore_id" type="BIGINT"/>
            <column name="ssl_keystore_id" type="BIGINT"/>
            <column name="metrics_id" type="BIGINT"/>
            <column name="audit_id" type="BIGINT"/>
            <column name="properties_json" type="CLOB"/>
            <column name="read_only" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="default_key_serde" type="VARCHAR(255)"/>
            <column name="default_value_serde" type="VARCHAR(255)"/>
            <column name="polling_throttle_rate" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 主表外键约束：Schema Registry Auth -->
    <changeSet id="005a" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_sr_auth"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="schema_registry_auth_id"
                constraintName="fk_cluster_sr_auth"
                referencedTableName="cluster_auth_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：Schema Registry SSL -->
    <changeSet id="005b" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_sr_ssl"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="schema_registry_ssl_id"
                constraintName="fk_cluster_sr_ssl"
                referencedTableName="cluster_ssl_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：ksqlDB Auth -->
    <changeSet id="005c" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_ksqldb_auth"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="ksqldb_server_auth_id"
                constraintName="fk_cluster_ksqldb_auth"
                referencedTableName="cluster_auth_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：ksqlDB SSL -->
    <changeSet id="005d" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_ksqldb_ssl"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="ksqldb_server_ssl_id"
                constraintName="fk_cluster_ksqldb_ssl"
                referencedTableName="cluster_ssl_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：SSL Truststore -->
    <changeSet id="005e" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_ssl_truststore"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="ssl_truststore_id"
                constraintName="fk_cluster_ssl_truststore"
                referencedTableName="cluster_ssl_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：SSL Keystore -->
    <changeSet id="005f" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_ssl_keystore"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="ssl_keystore_id"
                constraintName="fk_cluster_ssl_keystore"
                referencedTableName="cluster_ssl_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：Metrics -->
    <changeSet id="005g" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_metrics"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="metrics_id"
                constraintName="fk_cluster_metrics"
                referencedTableName="cluster_metrics_config"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- 主表外键约束：Audit -->
    <changeSet id="005h" author="kafka-ui">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_cluster_audit"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="cluster_config"
                baseColumnNames="audit_id"
                constraintName="fk_cluster_audit"
                referencedTableName="cluster_audit_config"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
